# Copy this file to .env.local and fill in your values

# Development Environment Variables
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Services (REQUIRED for AI features)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-api-key-here

# Google Cloud Vision (OPTIONAL - for enhanced recognition)
# Setup guide: https://cloud.google.com/vision/docs/setup
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Image Storage (OPTIONAL - for production)
# Cloudinary: https://cloudinary.com/
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Database (OPTIONAL - for production)
# Use PostgreSQL, MySQL, or SQLite
DATABASE_URL=postgresql://user:password@localhost:5432/inventiq

# AI Configuration
AI_CONFIDENCE_THRESHOLD=0.7  # Minimum confidence for auto-validation (0-1)
AI_MAX_RETRIES=3             # Max retries for failed API calls
AI_CACHE_TTL=3600            # Cache duration in seconds