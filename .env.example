# Copy this file to .env.local and update with your values

# OpenAI API
OPENAI_API_KEY=your_api_key_here

# MinIO Storage (S3-compatible)
# For local development (internal network):
# S3_ENDPOINT=http://10.2.200.102:9000
# S3_PUBLIC_URL=http://10.2.200.102:9000

# For production/external access:
S3_ENDPOINT=https://minio.mindbit.net
S3_BUCKET=inventiq
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_PUBLIC_URL=https://minio.mindbit.net

# PostgreSQL Database (Docker Compose)
# User: inventiq
# Password: inventiq2025
# Database: inventiq
DATABASE_URL=postgresql://inventiq:inventiq2025@localhost:5432/inventiq

# For production or different credentials:
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]

# Optional
NEXT_PUBLIC_APP_URL=http://localhost:3000
